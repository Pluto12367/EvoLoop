  "development": [
    {
      "id": "dev-prefix-sums",
      "function_name": "prefix_sums",
      "category": "sequences",
      "difficulty": "easy",
      "description": "Implement prefix_sums(values: list[int]) -> list[int]. Return cumulative sums in order; an empty list returns [].",
      "tests": [
        {
          "args": [
            []
          ],
          "expected": []
        },
        {
          "args": [
            [
              3
            ]
          ],
          "expected": [
            3
          ]
        },
        {
          "args": [
            [
              1,
              2,
              3
            ]
          ],
          "expected": [
            1,
            3,
            6
          ]
        },
        {
          "args": [
            [
              -2,
              5,
              -3
            ]
          ],
          "expected": [
            -2,
            3,
            0
          ]
        },
        {
          "args": [
            [
              0,
              0
            ]
          ],
          "expected": [
            0,
            0
          ]
        },
        {
          "args": [
            [
              1000000000000,
              -1
            ]
          ],
          "expected": [
            1000000000000,
            999999999999
          ]
        }
      ]
    },
    {
