    {
      "id": "dev-word-counts",
      "function_name": "word_counts",
      "category": "mappings",
      "difficulty": "easy",
      "description": "Implement word_counts(text: str) -> dict[str, int]. Split on whitespace and count casefolded tokens; punctuation remains part of a token; empty returns {}.",
      "tests": [
        {
          "args": [
            ""
          ],
          "expected": {}
        },
        {
          "args": [
            "a a b"
          ],
          "expected": {
            "a": 2,
            "b": 1
          }
        },
        {
          "args": [
            "Hello HELLO"
          ],
          "expected": {
            "hello": 2
          }
        },
        {
          "args": [
            " a\tB\na "
          ],
          "expected": {
            "a": 2,
            "b": 1
          }
        },
        {
          "args": [
            "hi hi!"
          ],
          "expected": {
            "hi": 1,
            "hi!": 1
          }
        },
        {
          "args": [
            "Straße STRASSE"
          ],
          "expected": {
            "strasse": 2
          }
        }
      ]
    },
